# Copy to .env and set values for your local 9Router instance.
GENIE_PROVIDER=openai
GENIE_BASE_URL=http://127.0.0.1:20128/v1
GENIE_MODEL=
# Set only when 9Router requires an API key. Keep the real key in .env.
GENIE_API_KEY=

# Ollama settings (switch GENIE_PROVIDER to ollama and GENIE_MODEL to its model ID)
OLLAMA_HOST=http://127.0.0.1:11434

# Shared generation settings
GENIE_TIMEOUT=120
GENIE_NUM_PREDICT=4096
GENIE_NUM_CTX=16384
